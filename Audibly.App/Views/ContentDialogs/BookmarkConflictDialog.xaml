<?xml version="1.0" encoding="utf-8" ?>

<ContentDialog
    CloseButtonText="Keep Existing"
    DefaultButton="Primary"
    PrimaryButtonText="Keep Both"
    SecondaryButtonText="Replace"
    Title="Bookmark Conflict"
    mc:Ignorable="d"
    x:Class="Audibly.App.Views.ContentDialogs.BookmarkConflictDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Audibly.App.Views.ContentDialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ContentDialog.Resources>
        <Style BasedOn="{StaticResource DefaultContentDialogStyle}" TargetType="local:BookmarkConflictDialog" />
    </ContentDialog.Resources>

    <StackPanel MinWidth="420" Spacing="12">
        <TextBlock
            Text="A bookmark already exists at the same position."
            TextWrapping="Wrap" />

        <TextBlock
            FontWeight="SemiBold"
            Text="{x:Bind LocationText, Mode=OneWay}"
            TextWrapping="Wrap" />

        <Border
            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
            CornerRadius="4"
            Padding="10">
            <StackPanel Spacing="4">
                <TextBlock FontWeight="SemiBold" Text="Existing note" />
                <TextBlock Text="{x:Bind ExistingNote, Mode=OneWay}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border
            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
            CornerRadius="4"
            Padding="10">
            <StackPanel Spacing="4">
                <TextBlock FontWeight="SemiBold" Text="New note" />
                <TextBlock Text="{x:Bind NewNote, Mode=OneWay}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <CheckBox Content="Apply to all remaining conflicts" x:Name="ApplyToAllCheckBox" />
    </StackPanel>
</ContentDialog>
