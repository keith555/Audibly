<?xml version="1.0" encoding="utf-8" ?>

<ContentDialog
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonText="Save"
    mc:Ignorable="d"
    x:Class="Audibly.App.Views.ContentDialogs.BookmarkEditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Audibly.App.Views.ContentDialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ContentDialog.Resources>
        <Style BasedOn="{StaticResource DefaultContentDialogStyle}" TargetType="local:BookmarkEditDialog" />
    </ContentDialog.Resources>

    <StackPanel MinWidth="420" Spacing="8">
        <TextBlock
            FontWeight="SemiBold"
            TextWrapping="Wrap"
            x:Name="LocationTextBlock" />

        <TextBox
            AcceptsReturn="True"
            Header="Note"
            MaxHeight="180"
            PlaceholderText="Add a note (optional)"
            TextWrapping="Wrap"
            x:Name="NoteTextBox" />
    </StackPanel>
</ContentDialog>
